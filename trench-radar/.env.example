# Copy to .env (gitignored). Every key is optional: missing ones show as "not configured"
# on the dashboard and the dependent score inputs are dropped (with lower confidence).

# --- Solana RPC (public endpoint works but rate-limits; a free Helius/Triton key is better)
# SOLANA_RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_KEY

# --- Social (X is billed per post read; the budget caps daily spend)
# X_BEARER_TOKEN=
# X_DAILY_READ_BUDGET=1000          # posts/day; ~$5/day at $0.005/post
# X_MAX_RESULTS=25                  # posts per query per run (min 10)
# X_QUERIES=(pump.fun OR pumpfun) -is:retweet lang:en|(memecoin OR "meme coin") solana -is:retweet
# REDDIT_CLIENT_ID=                 # "script" app at reddit.com/prefs/apps
# REDDIT_CLIENT_SECRET=
# REDDIT_SUBREDDITS=solana|SolanaMemeCoins|memecoins|CryptoMoonShots

# --- Optional on-chain enrichment
# BITQUERY_TOKEN=                   # buy vs sell USD volume (true net flow)

# --- AI analyst (falls back to the deterministic rules analyst)
# ANTHROPIC_API_KEY=
# ANALYST_MODEL=claude-opus-5-5
# ANALYST_EFFORT=medium

# --- Alerts and scheduled reports
# TELEGRAM_BOT_TOKEN=               # from @BotFather
# TELEGRAM_CHAT_ID=                 # your user/group id
# REPORT_TIMES_UTC=08:00|20:00
# ALERT_SCORE_DELTA=15
# ALERT_COOLDOWN_MIN=120

# --- Dashboard
# DASHBOARD_HOST=127.0.0.1          # keep local unless you set a token
# DASHBOARD_PORT=8787
# DASHBOARD_TOKEN=                  # required header x-radar-token for /api/*

# --- Storage and cadence (seconds; 0 disables a job)
# RADAR_DB=data/radar.db
# GT_MIN_INTERVAL_S=4.0             # GeckoTerminal spacing; raise it if you see 429s
# EVERY_LAUNCHES_S=180
# EVERY_REFRESH_S=300
# EVERY_CURVES_S=300
# EVERY_SOCIAL_S=1800
# EVERY_ANALYZE_S=600
# EVERY_OUTCOMES_S=1800
# MAX_TRACKED_TOKENS=600
